:80 {
    root * /srv
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:3000
    }

    # Проксируем скрипты Telegram Mini App через зарубежный мост
    handle_path /tg-js/* {
        reverse_proxy https://tg-proxy.odnokrovi.app {
            header_up Host tg-proxy.odnokrovi.app
            header_up X-Proxy-Secret "{$BRIDGE_TOKEN}"
        }
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }
}

:6000 {
    reverse_proxy max-bot:6000
}

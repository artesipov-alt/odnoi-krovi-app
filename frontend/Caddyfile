{
    email r.stupa@ya.ru
}

1krovi.app {
    # Прямое указание использовать Let's Encrypt вместо ZeroSSL
    tls r.stupa@ya.ru {
        issuer acme https://acme-v02.api.letsencrypt.org/directory
    }

    root * /srv
    encode gzip zstd

    handle /api/* {
        reverse_proxy backend:3000
    }

    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}

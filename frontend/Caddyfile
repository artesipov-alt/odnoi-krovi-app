{
    # Глобальные настройки: твой email для уведомлений от ACME
    email r.mayer.th@gmail.com
}

1krovi.app {

    root * /srv
    encode gzip zstd

    # API маршруты
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Проксирование скрипта Telegram Mini App
    handle_path /tg-js/* {
        # Дописываем секрет к запросу перед отправкой на мост
        rewrite * {uri}?secret={$BRIDGE_TOKEN}

        reverse_proxy https://bridge.1krovi.app {
            header_up Host bridge.1krovi.app
        }
    }

    # SPA routing
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}

dev.1krovi.app {
    reverse_proxy 10.0.0.73:80
}

prodbot.1krovi.app {
    reverse_proxy max-bot:6000
}

devbot.1krovi.app {
    reverse_proxy 10.0.0.73:6000
}

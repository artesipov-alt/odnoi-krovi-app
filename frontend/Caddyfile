{
    # Глобальные настройки: твой email для уведомлений от ACME
    email r.stupa@ya.ru
}

1krovi.app {
    # Указываем Let's Encrypt явно и без лишних параметров
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory
    }

    root * /srv
    encode gzip zstd

    # API маршруты
    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA routing
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}

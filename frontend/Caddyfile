    email r.stupa@ya.ru
}

1krovi.app {
    root * /srv
    encode gzip zstd

    # API routes first - handle all /api/* requests
    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA routing - serve index.html for all non-file requests
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    # Логирование для отладки
    log {
        output stdout
        format console
    }


}

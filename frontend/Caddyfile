    email r.stupa@ya.ru
}

1krovi.app {
    root * /srv
    file_server
    encode gzip zstd

    # API routes first
    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA routing - serve index.html for all non-API requests
    @spaFiles {
        file {
            try_files {path} {path}/ /index.html
        }
    }
    rewrite @spaFiles /index.html

    # Static file serving
    handle {
        file_server
    }

    # Логирование для отладки
    log {
        output stdout
        format console
    }

    # Error handling for SPA
    handle_errors {
        @404 {
            expression {http.error.status_code} == 404
        }
        rewrite @404 /index.html
        file_server
    }
}

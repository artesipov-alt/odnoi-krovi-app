    # Глобальные настройки: твой email для уведомлений от ACME
    email r.mayer.th@gmail.com
}

1krovi.app {

    root * /srv
    encode gzip zstd

    # API маршруты
    handle /api/* {
        reverse_proxy backend:3000
    }

    # SPA routing
    handle {
        try_files {path} {path}/ /index.html
        file_server
    }

    log {
        output stdout
        format console
    }
}

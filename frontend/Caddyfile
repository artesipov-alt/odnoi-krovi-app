# Используйте правильное доменное имя
1krovi.app {
    root * /srv
    file_server
    encode gzip zstd

    # Handle SPA routing - serve index.html for all non-file requests
    @notApi {
        not path /api/*
    }
    rewrite @notApi /index.html

    # API routes - должно быть до SPA routing
    handle /api/* {
        reverse_proxy backend:3000
    }

    # Логирование для отладки
    log {
        output stdout
        format console
    }

    # Error handling for SPA
    handle_errors {
        @404 {
            expression {http.error.status_code} == 404
        }
        rewrite @404 /index.html
        file_server
    }
}

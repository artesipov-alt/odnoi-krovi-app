{
  "name": "odnoi-krovi-max-bot",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "main": "dist/bot.js",
  "scripts": {
    "dev": "node --use-system-ca --env-file=../.env --import tsx bot.ts",
